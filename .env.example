# ─────────────────────────────────────────────────────────────
# Ofertaço Radar — variáveis de ambiente
# Copie para .env (nunca commitar .env — já está no .gitignore)
# ─────────────────────────────────────────────────────────────

# Banco (Supabase Postgres — session pooler)
DATABASE_URL=

# Auth do /admin e /login (Supabase Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://ofertacoradar.com.br

# ── Fontes de afiliado ────────────────────────────────────────
# Lomadee: API tem precedência; FEED_URL é o fallback XML/JSON
LOMADEE_API_KEY=
LOMADEE_API_URL=
LOMADEE_PRODUCTS=          # 1 = importa catálogo de produtos (link direto, SEM comissão)
FEED_URL=

# Mercado Livre (OAuth — scripts/ml-auth.ts gera o token inicial)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_AUTH_SECRET=
ML_AFFILIATE_TOOL=
ML_AFFILIATE_WORD=

# Awin (advertiser_id + feeds CSV/XML/JSON separados por vírgula)
AWIN_AFFID=
AWIN_FEEDS=

# Amazon — scrape local usa sessão logada; estas são para a futura PA-API
AMZ_TAG=synapsecodeon-20
AMZ_API_KEY=
AMZ_API_SECRET=
AMZ_HOST=
AMZ_REGION=
AMZ_MARKETPLACE=
AMZ_KEYWORDS=

# SerpApi (busca Amazon complementar)
SERPAPI_KEY=

# ── Automação / kit diário ────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=
KIT_EMAIL=
ADMIN_EMAILS=              # csv de emails com acesso /admin (vazio = KIT_EMAIL)
KIT_HEALTHCHECK_URL=
KIT_MUSIC_URLS=             # URLs separadas por vírgula
KIT_THEME_DAY=
CRON_SECRET=                # protege endpoints de cron
AFFILIATE_URL_OVERRIDE=     # override de URL de afiliado p/ testes

# ── Analytics / marketing ─────────────────────────────────────
NEXT_PUBLIC_GA_ID=          # GA4 — G-3MCVT83YZN
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_INSTAGRAM_URL=

# ── Chatwoot (widget do site) ─────────────────────────────────
# Defaults já no código; sobrescreva só se mudar de instância
NEXT_PUBLIC_CHATWOOT_BASE_URL=https://chat.ofertacoradar.com.br
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN=

# Cotas por fonte no sync completo (scripts/sync.ts). Vazio = default
# (lomadee 5000, ml 5000, awin 1000, amazon 500). Catalogo cheio ~22k+.
SYNC_QUOTA_LOMADEE=
SYNC_QUOTA_ML=
SYNC_QUOTA_AWIN=
SYNC_QUOTA_AMAZON=
