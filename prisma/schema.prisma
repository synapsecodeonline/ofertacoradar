generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["ofertacoradar"]
}

model Product {
  id           Int      @id @default(autoincrement())
  // Prefixo de fonte de afiliado:
  //   camp-lomadee: = oferta/cupom Lomadee | prod-lomadee: = produto Lomadee
  //   ml:          = produto Mercado Livre | aw:           = produto Awin
  externalId   String?  @unique
  title        String
  description  String?
  imageUrl     String?
  price        Float?
  oldPrice     Float?
  discountPct  Float?
  currency     String   @default("BRL")
  category     String?
  subtype      String?
  merchant     String?
  organizationId String?
  url          String
  affiliateUrl String?
  couponCode   String?
  endsAt       DateTime?
  active       Boolean  @default(true)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  clicks Click[]

  @@index([category])
  @@index([category, subtype])
  @@index([active])
  @@schema("ofertacoradar")
}

model Brand {
  id      String  @id
  name    String
  logo    String?
  site    String?
  segment String?

  @@schema("ofertacoradar")
}

model SyncState {
  key          String    @id
  phase        String    @default("brands")
  page         Int       @default(1)
  lastCycleAt  DateTime?
  busyAt       DateTime?
  orgsCleared  Boolean   @default(false)

  @@schema("ofertacoradar")
}

model AffiliatedOrg {
  organizationId String   @id
  name           String?
  updatedAt      DateTime @updatedAt

  @@schema("ofertacoradar")
}

model TrackedLink {
  id             Int      @id @default(autoincrement())
  sourceUrl      String   @unique
  organizationId String
  shortUrl       String
  createdAt      DateTime @default(now())

  @@schema("ofertacoradar")
}

model Click {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  referer   String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@schema("ofertacoradar")
}

// Evento de analytics real (pageview|click) — substitui o hack do
// produto sentinela. Criada via SQL manual (banco nao aceita db push
// do pooler); ver scripts/migration-events.sql.
model Event {
  id           Int      @id @default(autoincrement())
  type         String // "pageview" | "click"
  productId    Int?
  sessionId    String?
  path         String?
  referer      String?
  userAgent    String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  createdAt    DateTime @default(now())

  @@index([type, createdAt])
  @@index([sessionId])
  @@index([productId])
  @@schema("ofertacoradar")
}

// Captura de email "avise-me quando baixar" / newsletter.
model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  productId Int?
  createdAt DateTime @default(now())

  @@index([productId])
  @@schema("ofertacoradar")
}

// Historico de preco por produto (sync grava; pagina mostra menor preco).
model PriceHistory {
  id         Int      @id @default(autoincrement())
  productId  Int
  price      Float
  recordedAt DateTime @default(now())

  @@index([productId, recordedAt])
  @@schema("ofertacoradar")
}

// KV generico para estado de scripts que roda em ambiente efemero
// (GitHub Actions): o kit diario guarda aqui o historico de enviados
// (anti-repeticao de 14 dias) — antes ficava em kit-out/sent.json,
// que se perdia a cada run em maquina nova.
model ScriptState {
  key   String @id
  value Json

  @@schema("ofertacoradar")
}
