# ===== CORE =====
SECRET_KEY_BASE=COLE_AQUI_openssl_rand_hex_64
FRONTEND_URL=https://chat.ofertacoradar.com.br
RAILS_ENV=production
INSTALLATION_ENV=docker
INSTALLATION_NAME=Ofertaço Radar
DEFAULT_LOCALE=pt_BR
RAILS_LOG_TO_STDOUT=true

# ===== POSTGRES (container local do compose) =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=COLE_AQUI_senha_forte
POSTGRES_DATABASE=chatwoot_production

# ===== REDIS (container local do compose) =====
REDIS_URL=redis://redis:6379

# ===== EMAIL (Resend — convites, notificações, recuperação de senha) =====
MAILER_SENDER_EMAIL=chatwoot@ofertacoradar.com.br
SMTP_ADDRESS=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=COLE_AQUI_resend_api_key
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Auto-atendente (container bot/): responde conversas do widget via OpenRouter
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=
CHATWOOT_BOT_TOKEN=
CHATWOOT_BOT_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
