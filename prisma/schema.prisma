generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           Int      @id @default(autoincrement())
  externalId   String?  @unique
  title        String
  description  String?
  imageUrl     String?
  price        Float?
  oldPrice     Float?
  discountPct  Float?
  currency     String   @default("BRL")
  category     String?
  merchant     String?
  organizationId String?
  url          String
  affiliateUrl String?
  couponCode   String?
  endsAt       DateTime?
  active       Boolean  @default(true)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  clicks Click[]

  @@index([category])
  @@index([active])
}

model Brand {
  id   String  @id
  name String
  logo String?
  site String?
}

model SyncState {
  key          String    @id
  phase        String    @default("brands")
  page         Int       @default(1)
  lastCycleAt  DateTime?
  busyAt       DateTime?
  orgsCleared  Boolean   @default(false)
}

model AffiliatedOrg {
  organizationId String   @id
  name           String?
  updatedAt      DateTime @updatedAt
}

model TrackedLink {
  id             Int      @id @default(autoincrement())
  sourceUrl      String   @unique
  organizationId String
  shortUrl       String
  createdAt      DateTime @default(now())
}

model Click {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  referer   String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([productId])
}
